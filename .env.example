# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LangSmith
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=options-income-advisor-agent
# Logging
# Set to true to enable detailed LangChain debug logs (verbose output)
# Set to false (or omit) for normal INFO-level application logs only
LANGCHAIN_VERBOSE=false